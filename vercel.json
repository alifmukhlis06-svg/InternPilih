{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["hnd1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30,
      "excludeFiles": "{.git/**,.env*,**/*.local.php,.local-staging/**,database/**,uploads/**,storage/**,resources/**,**/*.{sql,gz,bak,pem,key,p12,pfx,jks},**/*{credentials,service-account}*.json,config/*.example.php,*.md,*.php,*.bat,setup-*.html,**/.htaccess,.gitignore}"
    }
  },
  "routes": [
    {
      "src": "/(?:config|database|uploads|storage|resources|server|\\.git|\\.local-staging)(?:/.*)?",
      "status": 404
    },
    {
      "src": "/(?:setup-database|setup-db|setup-using-heidisql|quick-setup|create-db|verify-database|test-connection|test-connection-methods)(?:\\..*)?",
      "status": 404
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/api/(?<endpoint>auth|applications|companies|document-file|documents|gemini|mail-status|notifications|offer-risk-ai|offers|password-reset|placement-changes|profile|reports|settings|summary|telegram-status)\\.php",
      "dest": "/api/index?endpoint=$endpoint"
    },
    { "src": "/api/.*", "status": 404 },
    { "src": "/.*\\.(?:php|sql|ini|bak|log|pem|key|p12|pfx|jks|env)", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/.*", "status": 404 }
  ]
}
