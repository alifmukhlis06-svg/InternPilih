# Required database connection for Vercel (Supabase Transaction pooler on 6543)
INTERNPILIH_DATABASE_DSN=
INTERNPILIH_DATABASE_USER=
INTERNPILIH_DATABASE_PASSWORD=
INTERNPILIH_DATABASE_POOL_MODE=transaction

# Required serverless application state
INTERNPILIH_SESSION_DRIVER=database
INTERNPILIH_SESSION_LIFETIME_SECONDS=7200
INTERNPILIH_RATE_LIMIT_DRIVER=database
INTERNPILIH_APP_URL=
# Preview-safe default. Change deliberately only for an approved production deployment.
INTERNPILIH_ENVIRONMENT=staging

# Required after the approved private Storage migration
INTERNPILIH_STORAGE_DRIVER=supabase
INTERNPILIH_SUPABASE_URL=
INTERNPILIH_SUPABASE_STORAGE_SECRET=
INTERNPILIH_STORAGE_BUCKET=documents

# Optional mail delivery. Use "disabled" for synthetic staging tests.
INTERNPILIH_MAIL_DRIVER=disabled
INTERNPILIH_MAIL_FROM_EMAIL=
INTERNPILIH_MAIL_FROM_NAME=InternPilih
INTERNPILIH_MAIL_REPLY_TO=
INTERNPILIH_SMTP_HOST=
INTERNPILIH_SMTP_PORT=587
INTERNPILIH_SMTP_ENCRYPTION=tls
INTERNPILIH_SMTP_USERNAME=
INTERNPILIH_SMTP_PASSWORD=

# Optional integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
INTERNPILIH_TELEGRAM_ENABLED=false
INTERNPILIH_TELEGRAM_BOT_TOKEN=
INTERNPILIH_TELEGRAM_CHAT_ID=
INTERNPILIH_TELEGRAM_COURSE_CHAT_IDS={}
INTERNPILIH_TELEGRAM_PROGRAMMES=[]
